%% Implementado por Daif

classDiagram
    User "1" <-- "1" Session : belongs to
    User "1" <-- "1" Account : belongs to
    User "1" <-- "*" Comment : belongs to

    class Verification {
        - id : string
        - value : string
        - expiresAt : Dates
        - createdAt : Date
        - updatedAt : Date
    }

    class User {
        - id : string [PK]
        - name : string
        - email : string
        - emailVerified : bool
        - image : string
        - createdAt : Date
        - updatedAt : Date
    }

    class Session {
        - id : string [PK]
        - userId : string [FK]
        - token : string
        - expiresAt : Date
        - ipAddress : string
        - userAgent : string
        - createdAt : Date
        - updatedAt : Date
    }

    class Account {
        - id : string [PK]
        - userId : string [FK]
        - providerId : string
        - accessToken : string
        - refreshToken : string
        - accessTokenExpiresAt : Date
        - refreshTokenExpiresAt : Date
        - scope : string
        - idToken : string
        - password : string
        - createdAt : Date
        - updatedAt : Date
    }
    
    Question"1" <--"*" Comment : has many
    Question"*" <-- "1" QuestionData : through
    Category"1" --> "*" Question : has many
    Answer "1" --> "*" QuestionData : has many

    class Category {
        - id : string [PK]
        - name : string
    }

    class Question {
        - id : string [PK]
        - xlsxId : string
        - value : string
        - categoryId : string [FK]
        + getAll(...params)
        + getById(...params)
        + load(xlsxPath : string)
    }

    class Answer {
        - id : string [PK]
        - value : string
    }

    class QuestionData {
        - id : string [PK]
        - answerId : string [FK]
        - questionId : string [FK]
        - result : float
        - segmentValueId : string [FK]
    }

    Segment"1" <-- "*" SegmentValue : belongs to
    SegmentValue <-- QuestionData : has many

    class Segment {
        - id : string [PK]
        - name : string
    }

    class SegmentValue {
        - id : string [PK]
        - name : string
        - segmentId : string [FK]
    }

    class Comment {
        - id : string [PK]
        - userId : string [FK]
        - questionId : string [FK]
        - msgContent : string
        - createdAt : Date
        + send()
    }